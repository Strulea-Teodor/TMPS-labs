<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Ignore any machine-wide "fallback package folders" (e.g. the one a removed
    Visual Studio install can leave behind in Program Files). The project has
    no NuGet dependencies, so nuget.org alone is more than enough.
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
